# Rust build output (huge — regenerated by wasm-pack)
target/

# Node deps (reinstall with `npm install`)
node_modules/

# Local editor/session state
.claude/
*.log

# Playwright E2E artifacts (regenerated by `npm run test:e2e`)
test-results/
playwright-report/

# Keep examples/demo/pkg/ committed so the demo runs with just Node (no Rust toolchain needed).
# wasm-pack drops a pkg/.gitignore that ignores everything — delete it after each build.
