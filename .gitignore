# Rust build output (huge — regenerated by wasm-pack)
/target/

# Node deps (reinstall with `npm install`)
/node_modules/

# Local editor/session state
/.claude/
*.log

# Keep pkg/ committed so the demo runs with just Node (no Rust toolchain needed).
# wasm-pack drops a pkg/.gitignore that ignores everything — we override that by removing it.
